# ===== OS Files =====
.DS_Store
Thumbs.db

# ===== CMake User Presets (user-specific, not tracked) =====
CMakeUserPresets.json

# ===== Cache =====
.cache/
__pycache__/
*.py[cod]

# ===== Parallel Feature Worktrees =====
.worktrees/
.claude/worktrees/

# ===== Claude runtime artifacts =====
.claude/scheduled_tasks.lock
.claude/settings.local.json
CLAUDE.local.md

# ===== Planning & Tracking Files (Session-Specific) =====
/task_plan.md
/task_plan_*.md
/findings.md
/progress.md
/BACKLOG.md
/RESOLVED.md
/TODO.md

# ===== Backup Files =====
*.bak
*.orig
*.backup

# ===== Performance Profiling Artifacts =====
# Trace binaries are large and machine-specific; reports (.md) ARE tracked.
bench/results/*.trace
bench/results/*.trace/
bench/results/*.xml
bench/results/*.profraw
bench/results/*.profdata
# PMU 单次采集 JSON 较小但与机器/时刻绑定，报告 .md 才入 git
bench/results/*.pmu.json
# Sweep automation outputs (timestamp filenames are per-run, not curated
# reports). Long-lived results should be renamed without the auto stamp.
bench/results/sweep_*.md
bench/results/combo_*.md

# PGO profile data (when produced outside build-*/ dirs)
pgo-profiles/
*.profraw
*.profdata
.myflicker/
