{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/project-guard.py",
            "args": [],
            "timeout": 5,
            "statusMessage": "Checking GNFS write boundary..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/project-guard.py",
            "args": [],
            "timeout": 10,
            "statusMessage": "Checking GNFS Harness integrity..."
          }
        ]
      }
    ]
  }
}
